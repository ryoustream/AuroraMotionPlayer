<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/aurora_void">

    <!-- Video surface -->
    <SurfaceView
        android:id="@+id/surface_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- Subtitle overlay -->
    <TextView
        android:id="@+id/subtitle_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="72dp"
        android:layout_marginHorizontal="16dp"
        android:background="#80000000"
        android:gravity="center"
        android:padding="4dp"
        android:textColor="@color/aurora_on_surface"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- Buffering indicator -->
    <ProgressBar
        android:id="@+id/progress_buffering"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/aurora_primary"
        android:visibility="gone" />

    <!-- Controls overlay (fades out after inactivity) -->
    <LinearLayout
        android:id="@+id/controls_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/player_controls_gradient"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Seek bar -->
        <SeekBar
            android:id="@+id/seek_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progressTint="@color/player_progress_played"
            android:thumbTint="@color/aurora_primary"
            android:secondaryProgressTint="@color/player_progress_buffered" />

        <!-- Time / controls row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="0:00:00"
                android:textColor="@color/aurora_on_surface"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:text="/"
                android:textColor="@color/aurora_on_surface_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/text_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="0:00:00"
                android:textColor="@color/aurora_on_surface_secondary"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btn_seek_back"
                style="@style/Widget.AppCompat.ImageButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/seek_backward"
                android:src="@android:drawable/ic_media_rew"
                android:tint="@color/aurora_on_surface" />

            <ImageButton
                android:id="@+id/btn_play_pause"
                style="@style/Widget.AppCompat.ImageButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/play"
                android:src="@android:drawable/ic_media_play"
                android:tint="@color/aurora_on_surface" />

            <ImageButton
                android:id="@+id/btn_seek_fwd"
                style="@style/Widget.AppCompat.ImageButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/seek_forward"
                android:src="@android:drawable/ic_media_ff"
                android:tint="@color/aurora_on_surface" />

            <ImageButton
                android:id="@+id/btn_fullscreen"
                style="@style/Widget.AppCompat.ImageButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/fullscreen"
                android:src="@android:drawable/ic_menu_zoom"
                android:tint="@color/aurora_on_surface" />

        </LinearLayout>
    </LinearLayout>

    <!-- AI stats overlay (top right, shown when AI active) -->
    <LinearLayout
        android:id="@+id/ai_stats_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:background="#B3000000"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/text_interp_fps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="AI: 60 FPS"
            android:textColor="@color/aurora_primary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/text_gpu_usage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="GPU: --%"
            android:textColor="@color/aurora_secondary"
            android:textSize="11sp" />

    </LinearLayout>

</FrameLayout>
