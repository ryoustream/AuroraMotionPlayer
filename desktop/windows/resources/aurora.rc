// Aurora Motion Player Windows Resource File
#include <windows.h>

// Version info
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Aurora"
            VALUE "FileDescription",  "Aurora Motion Player"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "AuroraPlayer"
            VALUE "LegalCopyright",   "Open Source"
            VALUE "OriginalFilename", "AuroraPlayer.exe"
            VALUE "ProductName",      "Aurora Motion Player"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// Application icon
IDI_ICON1 ICON "aurora.ico"
