<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Custom attributes for PlayerView -->
    <declare-styleable name="AuroraPlayerView">
        <attr name="showControls" format="boolean" />
        <attr name="autoHideDelay" format="integer" />
        <attr name="aspectRatio" format="enum">
            <enum name="fit" value="0" />
            <enum name="fill" value="1" />
            <enum name="original" value="2" />
            <enum name="stretch" value="3" />
        </attr>
    </declare-styleable>
</resources>
