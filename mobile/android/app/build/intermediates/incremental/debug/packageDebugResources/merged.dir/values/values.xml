    <style name="Theme.AuroraPlayer" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/aurora_primary</item>
        <item name="colorPrimaryVariant">@color/aurora_primary_variant</item>
        <item name="colorOnPrimary">@color/aurora_void</item>
        <item name="colorSecondary">@color/aurora_secondary</item>
        <item name="colorOnSecondary">@color/aurora_void</item>
        <item name="colorSurface">@color/aurora_surface</item>
        <item name="colorOnSurface">@color/aurora_on_surface</item>
        <item name="android:colorBackground">@color/aurora_deep_space</item>
        <item name="android:windowBackground">@color/aurora_deep_space</item>
        <item name="android:statusBarColor">@color/aurora_void</item>
        <item name="android:navigationBarColor">@color/aurora_void</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:textColorPrimary">@color/aurora_on_surface</item>
        <item name="android:textColorSecondary">@color/aurora_on_surface_secondary</item>
    </style>
    <style name="Theme.AuroraPlayer.Player" parent="Theme.AuroraPlayer">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:statusBarColor">#00000000</item>
        <item name="android:navigationBarColor">#00000000</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>
    <style name="Theme.AuroraPlayer.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/aurora_void</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_aurora_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.AuroraPlayer</item>
    </style>
    <declare-styleable name="AuroraPlayerView">
        <attr format="boolean" name="showControls"/>
        <attr format="integer" name="autoHideDelay"/>
        <attr format="enum" name="aspectRatio">
            <enum name="fit" value="0"/>
            <enum name="fill" value="1"/>
            <enum name="original" value="2"/>
            <enum name="stretch" value="3"/>
        </attr>
    </declare-styleable>
